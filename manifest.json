async function fetchIA(mensajes) {
  // Mantenemos la lista de modelos gratis de respaldo
  const modelos = ['openai', 'anthropic', 'mistral', 'qwen'];
  
  for (let model of modelos) {
    try {
      const r = await fetch('https://text.pollinations.ai/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: mensajes,
          model: model,
          private: true,
          cache: false
        })
      });
      
      if (r.ok) {
        const text = await r.text();
        // Validamos que la API no haya devuelto una cadena vacía o un error oculto
        if (text && text.trim().length > 0 && !text.includes('Error')) {
          return text;
        }
      }
    } catch (e) {
      console.warn(`El modelo ${model} falló o bloqueó el prompt. Siguiente...`);
    }
  }
  throw new Error("Ningún motor pudo procesar la solicitud.");
}
